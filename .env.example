# ---------------------------------------------------------------------------
# Sao Kim BrandCare OS — biến môi trường
# Sao chép file này thành `.env.local` rồi điền giá trị. KHÔNG commit `.env.local`.
# Danh sách đầy đủ và ý nghĩa: docs/01-tech-stack.md §4
# ---------------------------------------------------------------------------

# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Xác thực (better-auth) — sinh secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cơ sở dữ liệu — sqlite (mặc định) hoặc pg khi đã migrate
DB_DRIVER=sqlite
SQLITE_PATH=./data/app.db
DATABASE_URL=

# AI — DeepSeek là provider mặc định (docs/04)
# deepseek-flash: nhanh, rẻ, hỗ trợ tool-calling → dùng cho mọi tính năng UI
# deepseek-v4-pro: chỉ cho tác vụ suy luận nhiều bước
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_DAILY_COST_CAP_USD=5
# Provider dự phòng (tùy chọn, cắm thêm không cần sửa code nghiệp vụ)
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Lưu trữ tệp — local | s3 | gdrive-link
STORAGE_DRIVER=local

# Thông báo — console (dev) | smtp
MAIL_DRIVER=console
SMTP_URL=

# Tự động hoá: đẩy signal sang n8n → Zalo OA / Odoo CRM
N8N_WEBHOOK_URL=
